{
  "name": "xuva-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Xuva — self-hosted media server desktop launcher",
  "author": {
    "name": "Xuva",
    "email": "hello@xuva.app",
    "url": "https://github.com/jampat000/Xuva"
  },
  "homepage": "https://github.com/jampat000/Xuva",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist:win:unpacked": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.xuva.desktop",
    "productName": "Xuva",
    "copyright": "Copyright © 2024–2025 Xuva contributors",
    "artifactName": "xuva-v${version}-win-x64.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "package.json",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/xuva.ico",
      "target": [
        "dir"
      ],
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Xuva",
      "verifyUpdateCodeSignature": false
    }
  }
}
